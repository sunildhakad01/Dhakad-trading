# Copy this file to .env and fill in. NEVER share or commit .env.

# From NEO app -> Invest -> Trade API -> Your Applications
KOTAK_ACCESS_TOKEN=

# Registered mobile with country code, e.g. +919876543210
KOTAK_MOBILE=

# Your Unique Client Code
KOTAK_UCC=

# 6-digit MPIN
KOTAK_MPIN=

# Optional: TOTP secret (the base32 string behind your authenticator QR).
# If set, login is fully automatic. If empty, you'll be asked to type the
# 6-digit TOTP from your authenticator app at startup.
KOTAK_TOTP_SECRET=

# Optional: enables Claude API news-sentiment scoring (falls back to a
# built-in keyword scorer if left empty). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=

# HARD SAFETY SWITCH. Keep false. Orders cannot be placed while false.
LIVE_TRADING=false

# Server
HOST=127.0.0.1
PORT=8000
